# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API (or "API Keys")
#
# Only the PUBLIC (anon / publishable) key belongs here. It is safe in the browser
# because every table is protected by Row Level Security.
# NEVER put the service_role / secret key in any VITE_ variable or in frontend code.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY
